{
    "openapi": "3.0.0",
    "info": {
        "title": "Notes de frais API",
        "description": "API de gestion des notes de frais",
        "version": "1.0.0"
    },
    "paths": {
        "/api/auth/demo-users": {
            "get": {
                "operationId": "get_api_auth_demo_users",
                "responses": {
                    "200": {
                        "description": "Comptes de d\u00e9mo propos\u00e9s sur la page de connexion",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/DemoUserView"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "summary": "La requ\u00eate est trait\u00e9e par DemoLoginAuthenticator, qui r\u00e9pond avant d'atteindre ce contr\u00f4leur.",
                "description": "La route doit exister pour que le routeur (qui passe avant le firewall) ne r\u00e9ponde pas 404.",
                "operationId": "post_api_auth_login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "userId"
                                ],
                                "properties": {
                                    "userId": {
                                        "type": "integer"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Session ouverte : utilisateur courant",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserView"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Corps invalide"
                    },
                    "401": {
                        "description": "Compte inconnu"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "summary": "La requ\u00eate est trait\u00e9e par le logout du firewall (voir security.yaml et ApiLogoutListener).",
                "description": "D\u00e9clarer la route ici la limite \u00e0 POST : un simple lien ou une image ne peut pas d\u00e9connecter.",
                "operationId": "post_api_auth_logout",
                "responses": {
                    "204": {
                        "description": "Session ferm\u00e9e"
                    },
                    "401": {
                        "description": "Aucune session ouverte"
                    }
                }
            }
        },
        "/api/categories": {
            "get": {
                "operationId": "get_api_categories",
                "responses": {
                    "200": {
                        "description": "Cat\u00e9gories de d\u00e9pense",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/CategoryView"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/expenses": {
            "get": {
                "operationId": "get_api_expenses_list",
                "parameters": [
                    {
                        "name": "status",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "nullable": true,
                            "oneOf": [
                                {
                                    "$ref": "#/components/schemas/ExpenseStatus"
                                }
                            ],
                            "default": null
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Notes de l'utilisateur, les plus r\u00e9centes d'abord",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ExpenseView"
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "\u00c9tat inconnu"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            },
            "post": {
                "operationId": "post_api_expenses_create",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ExpenseInput"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Brouillon cr\u00e9\u00e9",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseView"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Champ invalide"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/expenses/{id}": {
            "get": {
                "operationId": "get_api_expenses_show",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Note",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseView"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Note inexistante ou d'un autre utilisateur"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            },
            "delete": {
                "operationId": "delete_api_expenses_delete",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Note en brouillon ou rejet\u00e9e supprim\u00e9e"
                    },
                    "404": {
                        "description": "Note inexistante ou d'un autre utilisateur"
                    },
                    "409": {
                        "description": "La note n'est ni en brouillon ni rejet\u00e9e"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            },
            "patch": {
                "operationId": "patch_api_expenses_update",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ExpenseInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Note en brouillon ou rejet\u00e9e modifi\u00e9e (tous les champs sont remplac\u00e9s)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseView"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Champ invalide"
                    },
                    "404": {
                        "description": "Note inexistante ou d'un autre utilisateur"
                    },
                    "409": {
                        "description": "La note n'est ni en brouillon ni rejet\u00e9e"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/expenses/{id}/submit": {
            "post": {
                "operationId": "post_api_expenses_submit",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Note soumise",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseView"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Note inexistante ou d'un autre utilisateur"
                    },
                    "409": {
                        "description": "La note n'est ni en brouillon ni rejet\u00e9e, ou son propri\u00e9taire n'a pas de responsable"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/expenses/{id}/approve": {
            "post": {
                "summary": "Valider : 404 si la note n'est pas visible (existence non r\u00e9v\u00e9l\u00e9e), 403 pour le propri\u00e9taire.",
                "operationId": "post_api_expenses_approve",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Note valid\u00e9e",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseView"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Le propri\u00e9taire ne d\u00e9cide pas de sa propre note"
                    },
                    "404": {
                        "description": "Note inexistante ou hors de l'\u00e9quipe"
                    },
                    "409": {
                        "description": "La note n'est pas soumise"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/expenses/{id}/reject": {
            "post": {
                "operationId": "post_api_expenses_reject",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RejectionInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Note rejet\u00e9e",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseView"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Motif invalide"
                    },
                    "403": {
                        "description": "Le propri\u00e9taire ne d\u00e9cide pas de sa propre note"
                    },
                    "404": {
                        "description": "Note inexistante ou hors de l'\u00e9quipe"
                    },
                    "409": {
                        "description": "La note n'est pas soumise"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/expenses/{id}/events": {
            "get": {
                "operationId": "get_api_expenses_events",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Historique, du plus ancien au plus r\u00e9cent",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ExpenseEventView"
                                    }
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Note inexistante ou non visible"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/exports/team-expenses.csv": {
            "get": {
                "tags": [
                    "Tableau de bord"
                ],
                "operationId": "get_api_exports_team_expenses",
                "responses": {
                    "200": {
                        "description": "CSV pour tableur fran\u00e7ais (BOM UTF-8, \u00ab ; \u00bb, montants \u00e0 virgule)",
                        "content": {
                            "text/csv": {
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    },
                    "403": {
                        "description": "R\u00e9serv\u00e9 aux managers"
                    }
                }
            }
        },
        "/api/health": {
            "get": {
                "operationId": "get_api_health",
                "responses": {
                    "default": {
                        "description": ""
                    }
                }
            }
        },
        "/api/me": {
            "get": {
                "operationId": "get_api_me",
                "responses": {
                    "200": {
                        "description": "Utilisateur courant et r\u00f4les accessibles",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserView"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/policies/{slug}": {
            "put": {
                "operationId": "put_api_policies_update",
                "parameters": [
                    {
                        "name": "slug",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PolicyInput"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Politique enregistr\u00e9e",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/CategoryView"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Plafond ou justificatif invalide"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    },
                    "403": {
                        "description": "R\u00e9serv\u00e9 \u00e0 l'admin"
                    },
                    "404": {
                        "description": "Cat\u00e9gorie inconnue"
                    }
                }
            }
        },
        "/api/expenses/{id}/receipt": {
            "get": {
                "tags": [
                    "Justificatifs"
                ],
                "operationId": "get_api_receipt_show",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Le fichier, affich\u00e9 par le navigateur (inline)",
                        "content": {
                            "image/jpeg": {},
                            "image/png": {},
                            "application/pdf": {}
                        }
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    },
                    "404": {
                        "description": "Note inexistante ou non visible"
                    }
                }
            },
            "post": {
                "tags": [
                    "Justificatifs"
                ],
                "operationId": "post_api_receipt_upload",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "file"
                                ],
                                "properties": {
                                    "file": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Justificatif joint ou remplac\u00e9",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseView"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Fichier absent, vide, trop lourd ou d'un type refus\u00e9"
                    },
                    "409": {
                        "description": "La note n'est ni en brouillon ni rejet\u00e9e"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    },
                    "404": {
                        "description": "Note inexistante ou non visible"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Justificatifs"
                ],
                "operationId": "delete_api_receipt_delete",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "pattern": "\\d+"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Justificatif retir\u00e9",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ExpenseView"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "La note n'est ni en brouillon ni rejet\u00e9e"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    },
                    "404": {
                        "description": "Note inexistante ou non visible"
                    }
                }
            }
        },
        "/api/stats/me": {
            "get": {
                "tags": [
                    "Tableau de bord"
                ],
                "operationId": "get_api_stats_me",
                "responses": {
                    "200": {
                        "description": "Nombre et total de ses notes pour chacun des quatre \u00e9tats",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/MyStatsView"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/stats/team": {
            "get": {
                "tags": [
                    "Tableau de bord"
                ],
                "operationId": "get_api_stats_team",
                "responses": {
                    "200": {
                        "description": "Notes valid\u00e9es de l'\u00e9quipe directe sur les 12 derniers mois civils, par cat\u00e9gorie et par mois",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TeamStatsView"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "R\u00e9serv\u00e9 aux managers"
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    }
                }
            }
        },
        "/api/team/expenses": {
            "get": {
                "operationId": "get_api_team_expenses",
                "responses": {
                    "200": {
                        "description": "Notes soumises de l'\u00e9quipe directe, les plus anciennes d'abord",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/ExpenseView"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Non connect\u00e9"
                    },
                    "403": {
                        "description": "R\u00e9serv\u00e9 aux managers"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ExpenseStatus": {
                "type": "string",
                "enum": [
                    "draft",
                    "submitted",
                    "approved",
                    "rejected"
                ]
            },
            "ExpenseListQuery": {
                "properties": {
                    "status": {
                        "nullable": true,
                        "oneOf": [
                            {
                                "$ref": "#/components/schemas/ExpenseStatus"
                            }
                        ],
                        "default": null
                    }
                },
                "type": "object"
            },
            "ExpenseInput": {
                "properties": {
                    "label": {
                        "type": "string",
                        "nullable": true,
                        "default": null,
                        "maxLength": 80,
                        "minLength": 2
                    },
                    "amountCents": {
                        "description": "Montant en centimes",
                        "type": "integer",
                        "nullable": true,
                        "default": null,
                        "maximum": 1000000,
                        "minimum": 0,
                        "exclusiveMinimum": true
                    },
                    "date": {
                        "type": "string",
                        "nullable": true,
                        "default": null
                    },
                    "categorySlug": {
                        "type": "string",
                        "nullable": true,
                        "default": null
                    }
                },
                "type": "object"
            },
            "RejectionInput": {
                "properties": {
                    "reason": {
                        "type": "string",
                        "nullable": true,
                        "default": null,
                        "maxLength": 1000,
                        "minLength": 5
                    }
                },
                "type": "object"
            },
            "PolicyInput": {
                "required": [
                    "receiptRequired"
                ],
                "properties": {
                    "maxAmountCents": {
                        "description": "Plafond en centimes ; null = aucun plafond",
                        "type": "integer",
                        "nullable": true,
                        "default": null,
                        "maximum": 1000000,
                        "minimum": 0,
                        "exclusiveMinimum": true
                    },
                    "receiptRequired": {
                        "type": "boolean",
                        "default": null
                    }
                },
                "type": "object"
            },
            "UserRole": {
                "type": "string",
                "enum": [
                    "employee",
                    "manager",
                    "admin"
                ]
            },
            "DemoUserView": {
                "required": [
                    "id",
                    "name",
                    "role"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/UserRole"
                    }
                },
                "type": "object"
            },
            "UserView": {
                "required": [
                    "id",
                    "name",
                    "email",
                    "role",
                    "accessibleRoles"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "role": {
                        "$ref": "#/components/schemas/UserRole"
                    },
                    "accessibleRoles": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/UserRole"
                        }
                    }
                },
                "type": "object"
            },
            "CategoryView": {
                "required": [
                    "slug",
                    "label",
                    "maxAmountCents",
                    "receiptRequired"
                ],
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    },
                    "maxAmountCents": {
                        "title": "Plafond par note en centimes ; null = aucun plafond",
                        "type": "integer",
                        "nullable": true
                    },
                    "receiptRequired": {
                        "type": "boolean"
                    }
                },
                "type": "object"
            },
            "PersonRef": {
                "required": [
                    "id",
                    "name"
                ],
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "ExpenseCategoryRef": {
                "required": [
                    "slug",
                    "label"
                ],
                "properties": {
                    "slug": {
                        "type": "string"
                    },
                    "label": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "PolicyCheck": {
